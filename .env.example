# ComfyUI API Wrapper Configuration
# Copy this file to .env and customize as needed

# ===========================================
# ComfyUI Connection
# ===========================================
COMFYUI_API_BASE=http://127.0.0.1:8188
COMFYUI_INSTALL_PATH=/workspace/ComfyUI

# ===========================================
# Worker Configuration
# ===========================================
PREPROCESS_WORKERS=3
GENERATION_WORKERS=2
POSTPROCESS_WORKERS=3
MAX_QUEUE_SIZE=100

# ===========================================
# Cache Configuration
# ===========================================
API_CACHE=memory
# API_CACHE=redis

# Redis settings (if using Redis cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===========================================
# S3 Storage Configuration (Optional)
# ===========================================
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=
S3_CONNECT_TIMEOUT=60
S3_CONNECT_ATTEMPTS=3

# ===========================================
# OVH S3-compatible Object Storage (dual-write, Azure -> OVH migration)
# Var names match the calling server repo's api/v1/services/storage/config.js exactly - that
# repo is the source of truth for naming/bucket layout. OVH_S3_AGENT_BUCKET / _PUBLIC_BUCKET
# are the agent-content bucket pair there (distinct from OVH_S3_USER_BUCKET, which is a
# different bucket for the user's own uploads) - this wrapper's output is always
# agent-generated, so it always belongs on the agent pair.
# ===========================================
OVH_DUAL_WRITE=true
OVH_S3_ENDPOINT=
OVH_S3_REGION=
OVH_S3_ACCESS_KEY_ID=
OVH_S3_SECRET_ACCESS_KEY=
OVH_S3_AGENT_BUCKET=
OVH_S3_SSE=AES256
# Public bucket (e.g. profile images) - same endpoint/region/credentials as above, just a
# different bucket. Create it with default (private) settings - each uploaded object gets
# ACL=public-read set individually at upload time, so no bucket-level policy is needed. Used
# whenever the request's webhook url has isPublic=true. Leave blank to keep all uploads private.
OVH_S3_AGENT_PUBLIC_BUCKET=

# Kill-switch: set to "false" to skip the Azure Blob upload entirely once OVH dual-write is
# stable (post-cutover) - OVH then becomes the awaited primary write and its failures fail the
# job (no more silent swallow). Var name/semantics mirror the server repo's own
# `AZURE_DUAL_WRITE` flag exactly. Default true (dual-write era) - flip only after confirming
# OVH_DUAL_WRITE above is healthy for this engine.
AZURE_DUAL_WRITE=true

# ===========================================
# Webhook Configuration (Optional)
# ===========================================
WEBHOOK_URL=
WEBHOOK_TIMEOUT=30

# ===========================================
# Development/Debug Configuration
# ===========================================
DEBUG=false

# ===========================================
# Example Production Configuration
# ===========================================

# For production with Redis and S3:
# API_CACHE=redis
# REDIS_HOST=redis-server
# S3_ACCESS_KEY_ID=your-production-key
# S3_SECRET_ACCESS_KEY=your-production-secret
# S3_BUCKET_NAME=your-production-bucket
# PREPROCESS_WORKERS=5
# GENERATION_WORKERS=3
# POSTPROCESS_WORKERS=5
# DEBUG=false

# For development:
# DEBUG=true